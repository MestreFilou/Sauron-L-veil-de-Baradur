{
  "name": "sauron-l-oeil-de-barad-dur",
  "private": true,
  "type": "module",
  "workspaces": [
    "engine",
    "world",
    "narrative",
    "audio",
    "client",
    "desktop"
  ],
  "scripts": {
    "dev": "npm run dev -w @sauron/client",
    "build": "npm run build -w @sauron/client",
    "test": "vitest run",
    "test:watch": "vitest",
    "banc": "vitest run -c vitest.banc.config.ts --silent=false",
    "typecheck": "tsc -p tsconfig.json && tsc -p client",
    "app": "npm run build && npm start -w @sauron/desktop",
    "app:dev": "npm run dev -w @sauron/desktop",
    "app:paquet": "npm run build && npm run paquet -w @sauron/desktop"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "~5.9.3",
    "vitest": "^5.1.0"
  }
}
